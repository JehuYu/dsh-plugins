{
  "name": "@local/dsh-exam-archive",
  "version": "1.0.3",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check xlsx.js",
    "test": "node --test tests/*.test.mjs"
  },
  "description": "从用户配置的钉钉群归档评分标准，查看各科收件情况并手动预演提醒；默认不发送消息。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "xlsx.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "tests/*.test.mjs"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JehuYu/dsh-plugins.git",
    "directory": "plugins/dsh-exam-archive"
  },
  "homepage": "https://github.com/JehuYu/dsh-plugins/tree/main/plugins/dsh-exam-archive",
  "bugs": {
    "url": "https://github.com/JehuYu/dsh-plugins/issues"
  }
}
