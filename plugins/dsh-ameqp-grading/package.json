{
  "name": "@local/dsh-ameqp-grading",
  "version": "2.0.0-candidate.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "parallel-host.js",
    "model-scheduler.js",
    "decisions.js",
    "decisions-samples.js",
    "client.js",
    "ameqp.js",
    "grading-policy.js",
    "streaming.js",
    "json-output.js",
    "format-recovery.js",
    "login-cipher.js",
    "seeds.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/json-output.test.js tests/streaming.test.js tests/login-cipher.test.js tests/grading.test.js tests/parallel.test.js tests/format-recovery.test.js tests/decisions.test.js",
    "test:client": "node --test tests/client.test.js tests/client-parallel.test.js tests/client-decisions.test.js"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JehuYu/dsh-plugins.git",
    "directory": "plugins/dsh-ameqp-grading"
  },
  "homepage": "https://github.com/JehuYu/dsh-plugins/tree/main/plugins/dsh-ameqp-grading",
  "bugs": {
    "url": "https://github.com/JehuYu/dsh-plugins/issues"
  }
}
