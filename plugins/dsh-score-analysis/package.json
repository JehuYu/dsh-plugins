{
  "name": "@local/dsh-score-analysis",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "小题成绩分析：上传原始小题分成绩，生成班级均分、信息/通用小题分析、教学班明细与成绩单压缩包，并保存为可复用的考试项目。",
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check xlsx-reader.js",
    "test": "node --test tests/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "xlsx-reader.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "python/**/*.py",
    "tests/*.test.mjs",
    "tests/manual-*.mjs",
    "python/vendor_xlrd/LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JehuYu/dsh-plugins.git",
    "directory": "plugins/dsh-score-analysis"
  },
  "homepage": "https://github.com/JehuYu/dsh-plugins/tree/main/plugins/dsh-score-analysis",
  "bugs": {
    "url": "https://github.com/JehuYu/dsh-plugins/issues"
  }
}
