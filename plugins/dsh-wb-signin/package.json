{
  "name": "@local/dsh-wb-signin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "WorkBuddy 签到面板：查看本机外部签到脚本的日志摘要、连签天数、积分与 Windows 计划任务，支持触发签到和添加账号。需自行配置 WorkBuddy-Daily 脚本。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JehuYu/dsh-plugins.git",
    "directory": "plugins/dsh-wb-signin"
  },
  "homepage": "https://github.com/JehuYu/dsh-plugins/tree/main/plugins/dsh-wb-signin",
  "bugs": {
    "url": "https://github.com/JehuYu/dsh-plugins/issues"
  }
}
